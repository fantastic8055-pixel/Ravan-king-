# Required
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# Optional provider credentials. A feature is shown as unavailable when its key
# is missing; the bot never invents a result.
TAVILY_API_KEY=
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
SERPAPI_API_KEY=

# Runtime
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
MAX_QUERY_LENGTH=300
MAX_URL_RESPONSE_BYTES=500000
